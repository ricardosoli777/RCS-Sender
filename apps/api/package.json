{
  "name": "@rcs/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file=../../.env --import tsx --watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file=../../.env dist/main.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "lint": "eslint src"
  },
  "dependencies": {
    "@rcs/config": "workspace:*",
    "@rcs/observability": "workspace:*",
    "fastify": "^5.0.0",
    "pg": "^8.0.0",
    "ioredis": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.0.0",
    "tsx": "^4.0.0",
    "vitest": "^3.0.0",
    "eslint": "^9.0.0"
  }
}
