# Copie este arquivo para .env e substitua os valores apenas no seu ambiente.
NODE_ENV=development
API_PORT=3001
# Origens HTTP(S), sem caminhos. APP_URL deve usar HTTPS em produção.
# API_URL é usado apenas no servidor, inclusive pela aplicação web.
APP_URL=http://localhost:3000
API_URL=http://localhost:3001
DATABASE_URL=postgresql://USUARIO:SENHA@HOST:5432/rcs_sender
REDIS_URL=redis://HOST:6379
LOG_LEVEL=info
# Obrigatórios em produção: dois segredos distintos de 32 bytes em hexadecimal.
# Não são valores NEXT_PUBLIC_* nem cabeçalhos fornecidos pelo navegador.
# RCS_EDGE_PROXY_SECRET=
# RCS_API_PROXY_SECRET=
# Criptografia de credenciais de provedores (opcional até configurar conexões).
# Gere chaves aleatórias de 32 bytes em hexadecimal; não reutilize segredos do proxy.
# RCS_CREDENTIAL_KEYS='{"key1":"SUBSTITUA_POR_64_CARACTERES_HEXADECIMAIS"}'
# RCS_CREDENTIAL_ACTIVE_KEY=key1
