# Reuse a verified binary only after verify-ops-release.py approves the diff.
ARG BASE_IMAGE
FROM ${BASE_IMAGE}
WORKDIR /app
USER root
COPY --chown=node:node . /app
USER node
ARG REVISION
ARG BASE_REVISION
LABEL org.opencontainers.image.revision=${REVISION}
LABEL rcs.compiled-base-revision=${BASE_REVISION}
